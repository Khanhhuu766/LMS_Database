# Cấu hình kết nối MS SQL Server cho hệ thống BK-LMS
# Thành viên nhóm copy file này thành file ".env" và chỉnh lại cho đúng máy mình

DB_SERVER=localhost\SQLEXPRESS
DB_NAME=LMS_DB
DB_DRIVER=ODBC Driver 18 for SQL Server
# Chọn "yes" để dùng Windows Authentication (khuyên dùng trên máy cá nhân)
# Nếu dùng tài khoản SQL (như sa), đổi thành "no" và điền DB_USER, DB_PASSWORD
DB_TRUSTED_CONNECTION=yes
DB_USER=
DB_PASSWORD=