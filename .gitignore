# =================================================================================
# .gitignore - Dự án BK-LMS (BTL2 Hệ Cơ sở Dữ liệu)
# =================================================================================

# File dữ liệu và sao lưu của MS SQL Server
*.mdf
*.ldf
*.ndf
*.bak
*.trn
*.dacpac
*.bacpac

# File tạm và nhật ký
*.log
*.tmp
*.temp
*~

# File tài liệu nháp chưa chính thức
main.pdf

# File rác hệ điều hành (Windows / macOS / Linux)
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride

# Cấu hình cá nhân của IDE / Editor
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# Môi trường ảo & file biên dịch Python (Phần 3 - FastAPI)
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.env
.env.local

# File trung gian khi biên dịch LaTeX (Báo cáo)
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.out
*.toc
*.synctex.gz
*.nav
*.snm
*.vrb
